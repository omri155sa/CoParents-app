# ============================================================
# CoParent Hub - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/coparent_hub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coparent_hub
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRATION=604800

# AES-256 Encryption (child data)
ENCRYPTION_KEY=your-32-char-encryption-key-here-!!

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=coparent-hub-files
AWS_REGION=eu-west-1

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDER_EMAIL=noreply@coparenthub.app
SENDER_NAME=CoParent Hub

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
